# Copy to .env and edit as needed. All values below are the defaults.

# --- Database -------------------------------------------------------------
# SQLite needs zero setup. Swap for Postgres with a single line:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/geospatial
DATABASE_URL=sqlite:///./geospatial.db

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./storage

# --- Upload limits --------------------------------------------------------
# Max size of the uploaded file itself (bytes). Default 100 MB.
MAX_UPLOAD_BYTES=104857600
# Max total size after extracting a zip archive (zip-bomb guard). Default 500 MB.
MAX_UNCOMPRESSED_BYTES=524288000
# Max compression ratio allowed for any single archive member (zip-bomb guard).
MAX_COMPRESSION_RATIO=200

# --- Measurement tuning ---------------------------------------------------
# Longitude span (degrees) above which a feature is measured geodesically
# instead of being projected to a single UTM zone.
MAX_UTM_LON_SPAN_DEGREES=6.0

# --- API ------------------------------------------------------------------
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
CORS_ORIGINS=*
LOG_LEVEL=INFO
